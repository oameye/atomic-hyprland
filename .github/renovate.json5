{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommitsDisabled",
    ":dependencyDashboard",
  ],
  timezone: "Europe/Brussels",
  schedule: ["before 6am on monday"],
  labels: ["dependencies"],
  packageRules: [
    {
      matchDepNames: [
        "basecamp/omarchy",
      ],
      groupName: "omarchy",
    },
    {
      // The compositor comes from a stable COPR release. Patch and minor bumps
      // must land in separate PRs (renovate lumps them together by default) so
      // that only patches can auto-merge.
      matchDepNames: ["hyprland"],
      separateMinorPatch: true,
    },
    {
      // A patch release is ABI-stable, and a stale pin *breaks* the build: the
      // COPR keeps only the newest aquamarine, so when its soname rolls the
      // pinned hyprland becomes uninstallable. Land these unattended, outside
      // the weekly window, once the PR image build is green.
      matchDepNames: ["hyprland"],
      matchUpdateTypes: ["patch"],
      schedule: ["at any time"],
      automerge: true,
      automergeType: "pr",
    },
    {
      // Minor/major can regress the whole session: boot-test by hand before merge.
      matchDepNames: ["hyprland"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
    {
      matchDepNames: [
        "gabm/Satty",
        "Gustash/Hyprshot",
        "sentriz/cliphist",
        "Vladimir-csp/xdg-terminal-exec",
        "abenz1267/walker",
        "abenz1267/elephant",
        "tsowell/wiremix",
        "pythops/bluetui",
        "pythops/impala",
        "charmbracelet/gum",
        "starship/starship",
        "WhySoBad/hyprland-preview-share-picker",
        "ryanoasis/nerd-fonts",
      ],
      groupName: "desktop support tools",
    },
  ],
  customManagers: [
    // GitHub-release-tracked tags. Each dep gets its own manager block so
    // the depName is explicit -- no fragile parsing of nearby comments.
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["OMARCHY_REF=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "basecamp/omarchy",
      datasourceTemplate: "github-releases",
    },
    // hyprland is packaged in the lionheartp COPR (tagged stable releases, not
    // GitHub tags), so it is tracked via the custom COPR datasource below instead
    // of github-releases. The COPR reports the version as X.Y.Z (e.g. 0.55.4);
    // renovate proposes a bump when a new stable release is packaged, which must
    // be boot-tested before merge.
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/pins\\.sh$/"],
      matchStrings: ["HYPRLAND_VERSION=\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "hyprland",
      packageNameTemplate: "hyprland",
      datasourceTemplate: "custom.copr",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["SATTY_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "gabm/Satty",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["HYPRSHOT_TAG=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "Gustash/Hyprshot",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["CLIPHIST_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "sentriz/cliphist",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["XDG_TERMINAL_EXEC_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "Vladimir-csp/xdg-terminal-exec",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["WALKER_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "abenz1267/walker",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["ELEPHANT_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "abenz1267/elephant",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["WIREMIX_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "tsowell/wiremix",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["BLUETUI_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "pythops/bluetui",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["IMPALA_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "pythops/impala",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["GUM_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "charmbracelet/gum",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["STARSHIP_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "starship/starship",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["HYPRLAND_PREVIEW_SHARE_PICKER_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "WhySoBad/hyprland-preview-share-picker",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["NERD_FONTS_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "ryanoasis/nerd-fonts",
      datasourceTemplate: "github-releases",
    },
  ],
  customDatasources: {
    // Reads the latest hyprland build from the Copr API v3 and reshapes it into
    // renovate's { releases: [{ version }] } form. The API reports the NEVRA as
    // "0.55.4-1.fc44"; substringBefore drops the "-1.fcNN" release so the tracked
    // value matches HYPRLAND_VERSION (version only) in pins.sh.
    copr: {
      defaultRegistryUrlTemplate: "https://copr.fedorainfracloud.org/api_3/package?ownername=lionheartp&projectname=Hyprland&packagename={{packageName}}&with_latest_build=true",
      format: "json",
      transformTemplates: [
        '{ "releases": [ { "version": $substringBefore(builds.latest.source_package.version, "-") } ] }',
      ],
    },
  },
}
