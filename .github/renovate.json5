{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommitsDisabled",
    ":dependencyDashboard",
  ],
  timezone: "Europe/Brussels",
  schedule: ["before 6am on monday"],
  labels: ["dependencies"],
  packageRules: [
    {
      matchDepNames: [
        "basecamp/omarchy",
      ],
      groupName: "omarchy",
    },
    {
      // The compositor rides a rolling COPR git build. A bump can regress the
      // whole session, so surface it on its own and never auto-merge it -- it
      // must be boot-tested by hand before merge.
      matchDepNames: ["hyprland-git"],
      groupName: "hyprland compositor",
      automerge: false,
    },
    {
      matchDepNames: [
        "gabm/Satty",
        "Gustash/Hyprshot",
        "sentriz/cliphist",
        "Vladimir-csp/uwsm",
        "Vladimir-csp/xdg-terminal-exec",
        "abenz1267/walker",
        "abenz1267/elephant",
        "tsowell/wiremix",
        "pythops/bluetui",
        "pythops/impala",
        "charmbracelet/gum",
        "starship/starship",
        "WhySoBad/hyprland-preview-share-picker",
        "ryanoasis/nerd-fonts",
      ],
      groupName: "desktop support tools",
    },
  ],
  customManagers: [
    // GitHub-release-tracked tags. Each dep gets its own manager block so
    // the depName is explicit -- no fragile parsing of nearby comments.
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["OMARCHY_REF=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "basecamp/omarchy",
      datasourceTemplate: "github-releases",
    },
    // hyprland-git is a rolling COPR build, not a GitHub tag, so it is tracked
    // via the custom COPR datasource below instead of github-releases. The
    // version format is RPM-snapshot (0.55.4^3.git9556660): the X.Y.Z prefix is
    // the last upstream stable tag, the ^N.gitHASH suffix is per-commit churn.
    // The regex versioning intentionally captures ONLY X.Y.Z (no end anchor), so
    // renovate ignores the ^N.gitHASH churn and proposes a bump only when a new
    // stable release is tagged. It then writes that release's current COPR build,
    // which must be boot-tested before merge.
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/pins\\.sh$/"],
      matchStrings: ["HYPRLAND_GIT_VERSION=\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "hyprland-git",
      packageNameTemplate: "hyprland-git",
      datasourceTemplate: "custom.copr",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["SATTY_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "gabm/Satty",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["HYPRSHOT_TAG=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "Gustash/Hyprshot",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["CLIPHIST_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "sentriz/cliphist",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["UWSM_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "Vladimir-csp/uwsm",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["XDG_TERMINAL_EXEC_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "Vladimir-csp/xdg-terminal-exec",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["WALKER_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "abenz1267/walker",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["ELEPHANT_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "abenz1267/elephant",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["WIREMIX_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "tsowell/wiremix",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["BLUETUI_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "pythops/bluetui",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["IMPALA_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "pythops/impala",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["GUM_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "charmbracelet/gum",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["STARSHIP_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "starship/starship",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["HYPRLAND_PREVIEW_SHARE_PICKER_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "WhySoBad/hyprland-preview-share-picker",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^build_files/(build|source-builds|pins)\\.sh$/"],
      matchStrings: ["NERD_FONTS_TAG=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "ryanoasis/nerd-fonts",
      datasourceTemplate: "github-releases",
    },
  ],
  customDatasources: {
    // Reads the latest hyprland-git build from the Copr API v3 and reshapes it
    // into renovate's { releases: [{ version }] } form. The API reports the
    // NEVRA as "0.55.4^43.git14fa1fd-1"; substringBefore drops the "-1" release
    // so the tracked value matches HYPRLAND_GIT_VERSION (version only) in pins.sh.
    copr: {
      defaultRegistryUrlTemplate: "https://copr.fedorainfracloud.org/api_3/package?ownername=craftidore&projectname=wayblueorg-hyprland&packagename={{packageName}}&with_latest_build=true",
      format: "json",
      transformTemplates: [
        '{ "releases": [ { "version": $substringBefore(builds.latest.source_package.version, "-") } ] }',
      ],
    },
  },
}
